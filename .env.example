# The template, committed on purpose and holding no values. Copy it to .env
# (which is gitignored) and fill that copy in:  cp .env.example .env
#
# Paste your key after the "=" with no quotes and no spaces, save the file, and
# restart the server (npm run serve). Get a key at:
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. The model "describe your search" calls. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. How many interpret calls one account gets per hour. Defaults to 5;
# 0 turns the limit off. Remove the # at the start of the line to use it.
# ANTHROPIC_CALLS_PER_HOUR=5
